{
  "rules": {
    "APP_OFFLINE": {
      ".read": "true"
    },
    "users": {
      ".indexOn": ["dateLastActive"],
      // all authenticateds users can read all users
      ".read": "root.child('APP_OFFLINE').val() !== true && auth != null",
      // authenticated users can only update/delete their own user
      "$user_id": {
        ".write": "root.child('APP_OFFLINE').val() !== true && auth != null && $user_id === auth.uid",
        "nickname": {
          ".validate": "!newData.exists() || (newData.isString() && newData.val().length >= 2 && newData.val().length <= 32)"
        }
      }
    },
    "user_uuids": {
      ".indexOn": ".value",
      // all authenticated users can read all user_uuids
      ".read": "root.child('APP_OFFLINE').val() !== true && auth != null",
      // authenticated users can create or delete user_uuids that match their own user ID
      "$uid": {
        ".write": "root.child('APP_OFFLINE').val() !== true &&
          auth != null && (
          (!data.exists() && newData.exists() && newData.val() === auth.uid) ||
          (!newData.exists() && data.val() === auth.uid)
        )"
      }
    },
    "user_blocks": {
      "$blocks_user_id": {
        // authenticated users can read and write to block lists whose ID matches their own user ID
        ".read": "root.child('APP_OFFLINE').val() !== true &&
          auth != null &&
          $blocks_user_id === auth.uid",
        ".write": "root.child('APP_OFFLINE').val() !== true &&
          auth != null &&
          $blocks_user_id === auth.uid",
      }
    },
    "user_spam_reports": {
      "$spam_reports_user_id": {
        // authenticated users can read and write to spam report lists whose ID matches their own user ID
        ".read": "root.child('APP_OFFLINE').val() !== true &&
          auth != null &&
          $spam_reports_user_id === auth.uid",
        ".write": "root.child('APP_OFFLINE').val() !== true &&
          auth != null &&
          $spam_reports_user_id === auth.uid",
      }
    },
    "chats": {
      "$chats_user_id": {
        // authenticated users can read chat lists whose ID matches their own user ID
        ".read": "root.child('APP_OFFLINE').val() !== true &&
          auth != null &&
          $chats_user_id === auth.uid",
        "$chats_other_user_id": {
          // authenticated users can create chats in ANY chat list
          // authenticated users can update chats where the parent id or chat id matches their own user ID
          // authenticated users can delete chats where the parent id matches their own user ID
          // TODO make this more granular so user can only update certain properties on foreign chats
          // (e.g. dateLastMessage, hasMessagesFromOtherUser, isTyping, etc)
          ".write": "root.child('APP_OFFLINE').val() !== true &&
            auth != null && (
              !data.exists() ||
              (data.exists() && newData.exists() && ($chats_user_id === auth.uid || $chats_other_user_id === auth.uid)) ||
              (!newData.exists() && $chats_user_id === auth.uid)
          )"
        }
      }
    },
    "chat_messages": {
      // (chat messages list ids are formatted: {USER1_ID}_{USER2_ID}) (the order of the id segments are alphanumeric sorted)
      "$chat_messages_id": {
        // authenticated users can read chat messages whose ID contains their own user ID
        ".read": "root.child('APP_OFFLINE').val() !== true &&
          auth != null &&
          $chat_messages_id.contains(auth.uid)",
        "$message_id": {
          ".indexOn": ["dateSent"],
          // authenticated users can only create chat messages whose ID contains their own user ID
          ".write": "root.child('APP_OFFLINE').val() !== true &&
            auth != null &&
            $chat_messages_id.contains(auth.uid) &&
            !data.exists() &&
            newData.exists()",
          "content": {
            ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 512"
          }
        }
      }
    },
    "spam_users": {
      ".indexOn": ["dateConvicted"],
      // all authenticated users can read all spam_users
      ".read": "root.child('APP_OFFLINE').val() !== true && auth != null"
    }
  }
}
