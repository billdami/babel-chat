{
  "name": "babel-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "test": "craco test",
    "eject": "react-scripts eject",
    "deploy:functions": "firebase deploy --only functions",
    "deploy:database": "firebase deploy --only database"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest",
      "plugin:import/recommended",
      "plugin:import/typescript"
    ],
    "plugins": [
      "import"
    ],
    "rules": {
      "import/order": [
        "warn",
        {
          "newlines-between": "always-and-inside-groups",
          "groups": [
            "builtin",
            "external",
            "internal",
            "parent",
            "sibling",
            "index",
            "object"
          ]
        }
      ]
    },
    "settings": {
      "import/extensions": [
        ".js",
        ".jsx",
        ".ts",
        ".tsx"
      ]
    }
  },
  "importSort": {
    ".js, .jsx, .es6, .es, .ts, .tsx": {
      "parser": "typescript",
      "style": "module-scoped",
      "options": {}
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "dependencies": {
    "@craco/craco": "^6.1.2",
    "@popperjs/core": "^2.9.2",
    "@testing-library/jest-dom": "^5.11.4",
    "@testing-library/react": "^11.1.0",
    "@testing-library/user-event": "^12.1.10",
    "@types/jest": "^26.0.15",
    "@types/luxon": "^1.26.5",
    "@types/node": "^12.0.0",
    "@types/react": "^17.0.0",
    "@types/react-dom": "^17.0.0",
    "@types/react-google-recaptcha": "^2.1.0",
    "@types/react-router-dom": "^5.1.7",
    "autoprefixer": "^9",
    "classnames": "^2.3.1",
    "eslint-plugin-import": "^2.23.2",
    "firebase": "^8.6.1",
    "identicon.js": "^2.3.3",
    "luxon": "^1.27.0",
    "postcss": "^7",
    "prettier": "^2.3.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "react-firebase-hooks": "^3.0.4",
    "react-google-recaptcha": "^2.1.0",
    "react-popper": "^2.2.5",
    "react-router-dom": "^5.2.0",
    "react-scripts": "4.0.3",
    "tailwindcss": "npm:@tailwindcss/postcss7-compat",
    "typescript": "^4.1.2",
    "use-debounce": "^6.0.1",
    "web-vitals": "^1.0.1"
  }
}
